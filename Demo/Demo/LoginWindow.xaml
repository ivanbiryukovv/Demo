<Window x:Class="ChudoObuv.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Чудо Обувь - Авторизация"
        Height="340"
        Width="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri"
        Icon="/Images/icon.ico"
        Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#70B2AF"
                BorderThickness="0,0,0,1"
                Background="#D2F6E7"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Images/icon.ico"
                       Width="40"
                       Height="40"
                       Stretch="Uniform"
                       Margin="0,0,10,0"/>
                <TextBlock Text="Чудо Обувь - Авторизация"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="300"
                    Margin="10">
            <TextBlock Text="Введите логин пользователя:"
                       FontSize="14"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="LoginBox"
                     Height="32"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Padding="5,0"/>

            <Button Content="Войти"
                    Height="34"
                    Margin="0,15,0,0"
                    FontSize="15"
                    FontWeight="Bold"
                    Background="#70B2AF"
                    Foreground="White"
                    Click="LoginButton_Click"/>

            <Button Content="Войти как гость"
                    Height="32"
                    Margin="0,10,0,0"
                    FontSize="14"
                    Background="#D2F6E7"
                    Click="GuestButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
