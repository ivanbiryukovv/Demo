<Window x:Class="ChudoObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Чудо Обувь - Каталог товаров"
        Height="650"
        Width="950"
        MinHeight="500"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri"
        Icon="/Images/icon.ico"
        Background="#FFFFFF">

    <Window.Resources>
        <DataTemplate x:Key="ProductCardTemplate">
            <Border BorderBrush="#70B2AF"
                    BorderThickness="1"
                    Margin="6,4"
                    Padding="8"
                    CornerRadius="4"
                    Background="{Binding Background}"
                    Cursor="Hand"
                    MouseLeftButtonUp="ProductBorder_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1"
                            Width="100"
                            Height="100"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White">
                        <Image Source="{Binding Picture}"
                               Stretch="Uniform"
                               Width="96"
                               Height="96"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="15,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductionAndName}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding CategoryName, StringFormat=Категория: {0}}"
                                   FontSize="13"
                                   Margin="0,3,0,0"/>

                        <TextBlock Text="{Binding QuantityStatus, StringFormat=Количество: {0}}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0"/>

                        <TextBlock Text="{Binding Compound, StringFormat=Состав: {0}}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DisplayPrice}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#1B5E20"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding OldPriceDisplay}"
                                   TextDecorations="Strikethrough"
                                   Foreground="#757575"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding DiscountVisibility}"/>

                        <TextBlock Text="Скидка 25%"
                                   Foreground="#C62828"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding DiscountVisibility}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#70B2AF"
                BorderThickness="0,0,0,1"
                Background="#D2F6E7"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Source="/Images/icon.ico"
                           Width="36"
                           Height="36"
                           Stretch="Uniform"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="Чудо Обувь - Каталог товаров"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="UserInfoTextBlock"
                               Text="Пользователь"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button x:Name="CartButton"
                            Content="Корзина (0)"
                            Background="#70B2AF"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            Click="CartButton_Click"/>

                    <Button x:Name="OrdersButton"
                            Content="Заказы"
                            Background="#70B2AF"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            Click="OrdersButton_Click"/>

                    <Button x:Name="LogoutButton"
                            Content="Выйти"
                            Background="#FFFFFF"
                            Padding="10,4"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="FilterPanel"
                Grid.Row="1"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,2,15,2" VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchBox"
                             Width="200"
                             Height="26"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,15,2" VerticalAlignment="Center">
                    <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CategoryComboBox"
                              Width="180"
                              Height="26"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CategoryComboBox_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,15,2" VerticalAlignment="Center">
                    <TextBlock Text="Цена:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="SortComboBox"
                              Width="160"
                              Height="26"
                              VerticalContentAlignment="Center"
                              SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                        <ComboBoxItem Content="По возрастанию цены"/>
                        <ComboBoxItem Content="По убыванию цены"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="ItemsCountTextBlock"
                           Text="Показано: 0 из 0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="10,2,0,2"/>
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Margin="5">
            <ItemsControl x:Name="ProductsList"
                          ItemTemplate="{StaticResource ProductCardTemplate}"/>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="#D2F6E7"
                Padding="10,4">
            <TextBlock Text="Подсказка: нажмите на товар для просмотра подробной информации и оформления заказа. Розовым цветом выделены товары с остатком 3 пары и менее."
                       FontSize="12"
                       Foreground="#333333"/>
        </Border>
    </Grid>
</Window>
