<Window x:Class="ChudoObuv.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Чудо Обувь - Оформление заказа"
        Height="500"
        Width="800"
        MinHeight="400"
        MinWidth="650"
        WindowStartupLocation="CenterOwner"
        FontFamily="Calibri"
        Icon="/Images/icon.ico"
        Background="#FFFFFF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#D2F6E7"
                BorderBrush="#70B2AF"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Images/icon.ico" Width="36" Height="36" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="Чудо Обувь - Оформление заказа"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           x:Name="UserInfoTextBlock"
                           Text="Пользователь"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#F9F9F9"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="15,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="CustomerLabel"
                           Text="Клиент:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox x:Name="CustomerComboBox"
                          Width="350"
                          Height="28"
                          VerticalContentAlignment="Center"
                          FontSize="14"/>
                <TextBlock x:Name="ClientStaticTextBlock"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  x:Name="CartItemsDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="10"
                  FontSize="14"
                  RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар (Производство | Модель)"
                                    Binding="{Binding TitleWithManufacturer}"
                                    Width="*"/>
                <DataGridTextColumn Header="Размер"
                                    Binding="{Binding SizeDisplay}"
                                    Width="80"/>
                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="90"/>
                <DataGridTextColumn Header="Цена за шт."
                                    Binding="{Binding UnitPriceDisplay}"
                                    Width="120"/>
                <DataGridTextColumn Header="Стоимость"
                                    Binding="{Binding TotalPriceDisplay}"
                                    Width="120"/>
                <DataGridTemplateColumn Header="Действие" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить"
                                    Background="#FF8080"
                                    Foreground="Black"
                                    FontWeight="SemiBold"
                                    Padding="6,2"
                                    Click="RemoveItemButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Background="#D2F6E7"
                BorderBrush="#70B2AF"
                BorderThickness="0,1,0,0"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Итоговая сумма по заказу: "
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalSumTextBlock"
                               Text="0,00 руб."
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1B5E20"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ConfirmOrderButton"
                            Content="Подтвердить заказ"
                            Height="34"
                            Padding="15,0"
                            Margin="0,0,10,0"
                            Background="#70B2AF"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            Click="ConfirmOrderButton_Click"/>

                    <Button Content="Отказаться от заказа"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,10,0"
                            Background="#FFFFFF"
                            FontSize="14"
                            Click="CancelOrderButton_Click"/>

                    <Button Content="Назад в каталог"
                            Height="34"
                            Padding="12,0"
                            Background="#FFFFFF"
                            FontSize="14"
                            Click="BackButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
