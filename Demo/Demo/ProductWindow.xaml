<Window x:Class="ChudoObuv.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Чудо Обувь - Просмотр товара"
        Height="540"
        Width="850"
        MinHeight="450"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        FontFamily="Calibri"
        Icon="/Images/icon.ico"
        Background="#FFFFFF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#D2F6E7"
                BorderBrush="#70B2AF"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Images/icon.ico" Width="36" Height="36" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="Чудо Обувь - Просмотр данных товара"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           x:Name="UserLogin"
                           Text="Пользователь"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#70B2AF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    Padding="10"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Width="260"
                    Height="260">
                <Image x:Name="ProductImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="15,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="TitleTextBlock"
                               Text="Наименование товара"
                               FontSize="20"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="ManufacturerTextBlock"
                               Text="Производство: "
                               FontSize="14"
                               Margin="0,6,0,0"/>

                    <TextBlock x:Name="CategoryTextBlock"
                               Text="Категория: "
                               FontSize="14"
                               Margin="0,4,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Цена: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PriceTextBlock"
                                   Text="0,00 руб."
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1B5E20"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="OldPriceTextBlock"
                                   Text=""
                                   FontSize="14"
                                   TextDecorations="Strikethrough"
                                   Foreground="#757575"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                        <TextBlock x:Name="DiscountBadgeTextBlock"
                                   Text=" (Скидка 25%)"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#C62828"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="CompoundTextBlock"
                               Text="Состав: "
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <TextBlock x:Name="DescriptionTextBlock"
                               Text="Описание: "
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <Separator Margin="0,10"/>

                    <TextBlock x:Name="SizeRangeTextBlock"
                               Text="Размерный ряд: "
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="AvailableSizesTextBlock"
                               Text="Доступные для заказа размеры: "
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0D47A1"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Background="#D2F6E7"
                BorderBrush="#70B2AF"
                BorderThickness="0,1,0,0"
                Padding="15,10">
            <Grid>
                <StackPanel x:Name="OrderControlsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <TextBlock Text="Размер:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
                    <ComboBox x:Name="SizeComboBox"
                              Width="180"
                              Height="30"
                              VerticalContentAlignment="Center"
                              Margin="0,0,15,0"/>

                    <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
                    <TextBox x:Name="QuantityBox"
                             Text="1"
                             Width="60"
                             Height="30"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="14"
                             Margin="0,0,15,0"/>

                    <Button x:Name="AddToCartButton"
                            Content="Добавить в заказ"
                            Width="140"
                            Height="32"
                            Background="#70B2AF"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="AddToCartButton_Click"/>
                </StackPanel>

                <TextBlock x:Name="GuestNoticeTextBlock"
                           Text="Для добавления товара в заказ авторизуйтесь в системе."
                           FontSize="14"
                           FontStyle="Italic"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="GoToCartButton"
                            Content="Оформить заказ"
                            Height="32"
                            Padding="12,0"
                            Margin="0,0,10,0"
                            Background="#70B2AF"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="GoToCartButton_Click"/>

                    <Button Content="Назад"
                            Width="90"
                            Height="32"
                            Background="#FFFFFF"
                            Click="BackButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
