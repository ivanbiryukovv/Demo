<Window x:Class="ChudoObuv.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Чудо Обувь - Управление заказами"
        Height="680"
        Width="950"
        MinHeight="550"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        FontFamily="Calibri"
        Icon="/Images/icon.ico"
        Background="#FFFFFF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#D2F6E7"
                BorderBrush="#70B2AF"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Images/icon.ico" Width="36" Height="36" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock x:Name="WindowTitleTextBlock"
                               Text="Чудо Обувь - Список заказов"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserInfoTextBlock"
                               Text="Пользователь"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button Content="Назад в каталог"
                            Background="#FFFFFF"
                            Padding="10,4"
                            Click="BackButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск заказа (по номеру или клиенту):"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="14"/>
                <TextBox x:Name="SearchOrderBox"
                         Width="250"
                         Height="26"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchOrderBox_TextChanged"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  x:Name="OrdersDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="10,6"
                  FontSize="14"
                  RowHeight="30"
                  SelectionChanged="OrdersDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Заказа"
                                    Binding="{Binding OrderNumber}"
                                    Width="100"/>
                <DataGridTextColumn Header="Дата заказа"
                                    Binding="{Binding OrderDateDisplay}"
                                    Width="130"/>
                <DataGridTextColumn Header="ФИО Клиента"
                                    Binding="{Binding ClientFullName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Сумма заказа"
                                    Binding="{Binding TotalSumDisplay}"
                                    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Background="#EBF9F3"
                BorderBrush="#70B2AF"
                BorderThickness="0,1,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelectedOrderHeaderTextBlock"
                           Text="Состав заказа (выберите заказ в таблице выше):"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            x:Name="AdminDateEditPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="Изменить дату:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               FontSize="13"/>
                    <DatePicker x:Name="OrderDatePicker"
                                Width="130"
                                Height="26"
                                VerticalContentAlignment="Center"
                                Margin="0,0,6,0"/>
                    <Button Content="Сохранить дату"
                            Background="#70B2AF"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="8,3"
                            Click="SaveDateButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="4"
                  x:Name="OrderItemsDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="10,6"
                  FontSize="13"
                  RowHeight="28">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товарная позиция (Производство | Наименование)"
                                    Binding="{Binding ProductTitle}"
                                    Width="*"/>
                <DataGridTextColumn Header="Размер"
                                    Binding="{Binding SizeDisplay}"
                                    Width="90"/>
                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="90"/>
                <DataGridTextColumn Header="Цена за ед."
                                    Binding="{Binding UnitPriceDisplay}"
                                    Width="120"/>
                <DataGridTextColumn Header="Итоговая сумма"
                                    Binding="{Binding TotalPriceDisplay}"
                                    Width="130"/>
                <DataGridTemplateColumn x:Name="DeleteOrderItemColumn" Header="Действие" Width="130" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить позицию"
                                    Background="#FF8080"
                                    Foreground="Black"
                                    Padding="6,2"
                                    Click="DeleteOrderItemButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="5"
                Background="#D2F6E7"
                BorderBrush="#70B2AF"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Итоговая сумма по заказу: "
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SelectedOrderSumTextBlock"
                               Text="0,00 руб."
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1B5E20"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AddNewOrderButton"
                            Content="Добавить заказ"
                            Height="32"
                            Padding="12,0"
                            Margin="0,0,10,0"
                            Background="#70B2AF"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="AddNewOrderButton_Click"/>

                    <Button x:Name="DeleteOrderButton"
                            Content="Удалить заказ"
                            Height="32"
                            Padding="12,0"
                            Margin="0,0,10,0"
                            Background="#FF8080"
                            FontWeight="Bold"
                            Click="DeleteOrderButton_Click"/>

                    <Button Content="Назад"
                            Height="32"
                            Width="80"
                            Background="#FFFFFF"
                            Click="BackButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
